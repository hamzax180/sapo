# server/ is NO LONGER excluded — api/index.js require()s it, so the
# Express app now ships as a Vercel serverless function. Excluding it
# would build a frontend whose every /api call 404s.

# The container deployment plane. It is a Docker stack that runs on its own
# VM — compose file, worker, Postgres schema — and nothing under server/ or
# api/ require()s it. On Vercel it is 4MB of source that can never execute,
# and its own package.json sitting in the tree only gives the build another
# manifest to get confused by.
deploy/

# Dev/build scratch
scratch/
*.py

# Local tooling
.claude/
node_modules/

# Tests and docs never need to reach a deployment
server/tests/
docs/

# The scaffold directory is excluded, and nothing at runtime reads it:
# scaffold-files.js requires scaffold-data.json instead, which is generated
# by scripts/build-scaffold-data.js and IS shipped.
#
# It has to be excluded. Included, Vercel's function bundler transpiles the
# TypeScript it finds here — App.tsx becomes App.js plus a source map,
# vite.config.ts becomes vite.config.js — while index.html still asks for
# main.tsx, so a deployed app builds 2 modules and dies in workbox with an
# empty dist. Excluding it without the JSON is the opposite failure:
# "Rollup failed to resolve import /src/main.tsx". The blob avoids both,
# because a .json is neither compiled nor dropped.
server/lib/codeagent/scaffold/

# Test and demo scripts — not imported by the app, just inflate the bundle.
server/*-test.js
server/*-demo.js
server/dev-admin-verify.js
