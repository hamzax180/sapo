# ─── Deployment plane ────────────────────────────────────────────────
# Copy to .env. Never commit the real file.

# Postgres
DATABASE_URL=postgres://souqi:souqi@localhost:5432/souqi_deploy

# The wildcard zone. A DNS record for *.APP_DOMAIN must point at this host,
# and Caddy issues a certificate per hostname on first request.
APP_DOMAIN=localhost
# Set to a real address in production so Caddy can reach Let's Encrypt.
ACME_EMAIL=

# Caddy's admin API. Bound to ONE address on the platform network — never
# 0.0.0.0, because Caddy also joins every per-app network in order to proxy to
# containers, and a wildcard bind would put the admin API (which can re-route
# any hostname) on an interface every untrusted user container can reach.
CADDY_ADMIN=http://localhost:2019

# The platform network, pinned so Caddy has a stable address to bind above.
# Change both together if this subnet collides with something on the host —
# and edit caddy/caddy.json to match, since plain JSON cannot read env vars.
# preflight.js fails if the three disagree.
PLATFORM_SUBNET=10.89.0.0/24
CADDY_ADMIN_IP=10.89.0.10

# Where builds are staged on the host. Wiped after each deploy.
BUILD_ROOT=/opt/platform/builds

# Default per-container limits. Admin-tunable; every deployment stores its
# own copy so raising the default never silently resizes running apps.
DEFAULT_CPU=0.5
DEFAULT_MEMORY_MB=512
DEFAULT_PIDS=100

# Admission control. New deployments are refused above these.
MAX_CONTAINERS=40
MAX_MEMORY_PCT=80
MAX_DISK_PCT=80

# 32 bytes hex — encrypts project env vars at rest.  openssl rand -hex 32
SECRET_KEY=

# ─── Sessions ────────────────────────────────────────────────────────
# MUST match the main app JWT_SECRET. The deploy plane verifies the same
# sq_session cookie, so being signed in to Souqi means being signed in here.
JWT_SECRET=

# Where to ask whether a session has been revoked. The main app owns the
# sessionEpoch that answers it. Unset = signature and expiry only, which
# means a revoked token keeps working until it expires (12h).
AUTH_INTROSPECT_URL=http://localhost:4000/api/account/me

# Shared secret for platform-to-platform calls with no user behind them —
# the Caddy TLS-ask endpoint. openssl rand -hex 32
INTERNAL_TOKEN=

# Trusts an x-user-id header instead of a session. Local development only:
# the API refuses to start with this set alongside NODE_ENV=production.
ALLOW_DEV_AUTH=0

# Object storage for source archives (S3-compatible: R2, S3, MinIO).
# Unset = archives stay on the VM, which the spec warns against for anything
# beyond local development.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Hetzner ─────────────────────────────────────────────────────────
# Used by scripts/provision.js to create the host, and later by the
# scheduler. A read/write API token: Console -> Security -> API tokens.
HETZNER_TOKEN=
HETZNER_LOCATION=nbg1
# cx32 is 4 vCPU / 8GB / 80GB — the size the capacity numbers assume.
# cx22 (2 vCPU / 4GB) is roughly half the price and fits ~4 apps, not 10.
HETZNER_SERVER_TYPE=cx32
HETZNER_IMAGE=docker-ce
# Blank = use the first key in the project. provision.js refuses to create
# a server when the project has no SSH key at all.
HETZNER_SSH_KEY_ID=

# ─── Postgres (platform database) ────────────────────────────────────
# Read by docker-compose. The database is never published off the box, but
# a default password still ends up in every image layer and log that quotes
# the DATABASE_URL, so set a real one.  openssl rand -hex 24
POSTGRES_USER=souqi
POSTGRES_PASSWORD=
POSTGRES_DB=souqi_deploy

# ─── Host ────────────────────────────────────────────────────────────
# production turns on the fatal boot guards in src/api/auth.js.
NODE_ENV=development
# Identifies this VM once there is more than one. Leave as local until then.
HOST_ID=local
