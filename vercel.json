{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/code",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/agent",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/agent/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/home"
    },
    {
      "source": "/signup",
      "destination": "/signup"
    },
    {
      "source": "/agent",
      "destination": "/code"
    },
    {
      "source": "/agent/:slug",
      "destination": "/code"
    },
    {
      "source": "/build",
      "destination": "/home"
    },
    {
      "source": "/settings",
      "destination": "/settings"
    },
    {
      "source": "/projects",
      "destination": "/projects"
    },
    {
      "source": "/deployments",
      "destination": "/deployments"
    },
    {
      "source": "/mobile",
      "destination": "/mobile"
    },
    {
      "source": "/portal/:path*",
      "destination": "/portal"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/s/:path*",
      "destination": "/api/index"
    }
  ]
}
