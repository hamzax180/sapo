# ── MERVEKS SAP backend configuration ───────────────────────────────
# Copy this file to ".env" and fill in your values.

# MongoDB connection string.
#   • Local Mongo:  mongodb://127.0.0.1:27017
#   • MongoDB Atlas (free M0):
#     mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017

# Database name (created automatically on first write).
DB_NAME=merveks_sap

# Port the API listens on.
PORT=4000

# Allowed browser origin(s) for CORS. Use "*" in dev ONLY. In production, set
# this to your actual domain(s) — e.g. https://souqi.site,https://www.souqi.site
# Leaving "*" in prod lets any origin call your API with credentials.
CORS_ORIGIN=*

# Secret used to sign login tokens. MUST be a long random string in prod.
JWT_SECRET=change-this-to-a-long-random-secret-string

# Google Gemini API key — kept server-side so it never ships to the browser.
# Leave blank to disable the live AI proxy (offline engine still works).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# AI adapter (docs/AI-PROVIDER-PLAN.md §3) — routes prose to Gemini, strict
# JSON/coding to DeepSeek, through one client. AI_ENABLED=0 (default) means
# every deterministic path runs exactly as it does with no keys at all;
# this is a strict enhancement, never a dependency.
AI_ENABLED=0
AI_MONTHLY_BUDGET_USD=5

AI_PROSE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_PROSE_MODEL=gemini-2.0-flash
AI_PROSE_KEY=

AI_JSON_BASE_URL=https://api.deepseek.com
AI_JSON_MODEL=deepseek-chat
AI_JSON_KEY=

# Souqi Code (docs/CODE-AGENT-PLAN.md §9): per-owner monthly spend cap, on
# top of (not instead of) AI_MONTHLY_BUDGET_USD above. That one protects
# the whole platform's shared AI budget from running away in aggregate;
# this one stops a single anonymous visitor from being the reason it does.
# 0 disables the check.
CODEAGENT_OWNER_MONTHLY_BUDGET_USD=1

# ---------------------------------------------------------------------
# Bring-your-own-key model providers (the "Model Provider" picker)
# ---------------------------------------------------------------------
# Users can paste their own Anthropic / Gemini / OpenAI / DeepSeek key and
# run their builds on it instead of Souqi's models. Their key is stored
# encrypted against their account, so this is REQUIRED for that feature:
# without it POST /api/account/ai-keys refuses (503) rather than writing a
# live third-party credential to the database in plaintext.
#
# 32 bytes, hex or base64:  openssl rand -hex 32
DB_ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# MCP servers (Powered Souqi only)
# ---------------------------------------------------------------------
# Extra tools the agent can call before it writes code. Either set the
# JSON inline here, or copy server/mcp.example.json to server/mcp.json
# (this variable wins if both exist). Empty = no MCP tools, which is the
# default and is not an error.
#   MCP_SERVERS={"mcpServers":{"docs":{"command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","./docs"]}}}
MCP_SERVERS=

# ─── Container deployments (the deploy plane) ────────────────────────
# The service in deploy/ that builds user apps into Docker images and
# runs them. Unset = the Deployments dashboard shows "not configured"
# and every deploy route answers 503, which is the correct state on a
# machine that is not running the stack.
#
# Locally: docker compose up -d in deploy/ (docker-compose.override.yml
# publishes the API on loopback for exactly this).
#   DEPLOY_API_URL=http://127.0.0.1:4500
#
# In production the deploy API is NOT on the public internet. Point this
# at the control-plane hostname Caddy routes to the api service, and set
# DEPLOY_PLATFORM_TOKEN to the shared secret that hostname requires —
# without it, the deploy API would be sitting on the internet protected
# by session auth alone.
DEPLOY_API_URL=
DEPLOY_PLATFORM_TOKEN=

# ─── Code agent context window ───────────────────────────────────────
# How much of a project's source is shown to the model on a follow-up
# edit. Files are fitted whole where they fit; anything excerpted or left
# out is announced in the prompt itself, so the model never silently
# edits half a file.
#
# Input is cheap (~$0.27 per million tokens), so 120K chars is well under
# a cent per edit — the previous 30K limit was not a cost decision. Raise
# it for large projects; lower it only if you are deliberately trading
# quality for spend.
CODEAGENT_MAX_CODE_CHARS=120000
# Backstop on the whole user message. Keep it above the code budget:
# this one is a hard slice, and slicing here would undo the honesty above.
CODEAGENT_MAX_PROMPT_CHARS=140000

# ─── CAPTCHA (bot protection for signup and public forms) ────────────
# Set CAPTCHA_SECRET to enable. Leave blank to disable (open in dev).
# CAPTCHA_PROVIDER: "turnstile" (Cloudflare, default) or "recaptcha" (Google)
CAPTCHA_SECRET=
CAPTCHA_PROVIDER=turnstile

# ─── Visit tracking salt ─────────────────────────────────────────────
# Random string mixed into the daily visitor hash. Change it to make
# hashes unique to your deployment.
VISIT_SALT=

# ─── Distributed Rate Limiting (Upstash / Vercel KV) ──────────────────
# Optional. On Vercel serverless, in-memory rate limiting resets between
# cold starts. Set these to enable distributed rate limiting via Upstash Redis:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
